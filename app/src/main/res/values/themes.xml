<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.F7" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/brand_indigo</item>
        <item name="android:navigationBarColor">@color/brand_indigo</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="Theme.F7.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_indigo</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.F7</item>
    </style>
</resources>
